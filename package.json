{
  "name": "dsh-ponytail-58fly",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "A self-maintained lazy-mode plugin for DeepSeek Harness: mode-graded guidance, fence-aware prompt filtering and a two-language skill catalog.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ponytail",
    "prompt",
    "skill"
  ],
  "license": "MIT",
  "author": {
    "name": "sunjingzhi",
    "email": "dlyh@vip.qq.com",
    "url": "https://github.com/58fly"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/58fly/dsh-ponytail-58fly.git"
  },
  "bugs": {
    "url": "https://github.com/58fly/dsh-ponytail-58fly/issues"
  },
  "homepage": "https://github.com/58fly/dsh-ponytail-58fly#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/plugin.js",
  "types": "lib/types/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:matrix": "node scripts/dsh-matrix.mjs --check",
    "measure": "node scripts/measure-prompt.mjs",
    "verify:release": "node scripts/verify-release.mjs --verify",
    "verify:published": "node scripts/verify-published.mjs",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run verify && pnpm run check:skills && pnpm run check:matrix && pnpm test && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
